{
  "manifest_version": 3,
  "name": "Fieldnote Website AI",
  "version": "0.1.0",
  "description": "Ask grounded questions about the website you are viewing.",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": { "default_title": "Open Fieldnote" },
  "side_panel": { "default_path": "index.html" }
}
